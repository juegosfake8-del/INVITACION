<script>


/* =========================================
   CUANDO TOCAN "ENCIENDE"
========================================= */

function encender() {

    const inicio =
        document.getElementById("inicio");

    /* PRIMERO: AZUL → ROJO */

    inicio.classList.add("encendiendo");


    /* DESPUÉS DE LA TRANSICIÓN:
       APARECE TODO LO DEMÁS */

    setTimeout(() => {

        inicio.classList.add("ocultar");

        iniciarParticulas();

    }, 1200);

}


/* =========================================
   CREAR PARTICULA
========================================= */

function crearParticula() {

    const pantalla =
        document.querySelector(".pantalla");

    const particula =
        document.createElement("div");

    particula.classList.add("particula");


    particula.style.left =
        15 + Math.random() * 70 + "%";


    const tamaño =
        2 + Math.random() * 5;

    particula.style.width =
        tamaño + "px";

    particula.style.height =
        tamaño + "px";


    particula.style.setProperty(

        "--altura",

        -(250 + Math.random() * 450) + "px"

    );


    particula.style.setProperty(

        "--movimiento",

        (Math.random() * 140 - 70) + "px"

    );


    const duracion =
        2 + Math.random() * 3;

    particula.style.animationDuration =
        duracion + "s";


    pantalla.appendChild(particula);


    /* =========================================
       LA PARTÍCULA SE ELIMINA JUSTO CUANDO
       TERMINA SU ANIMACIÓN
    ========================================= */

    particula.addEventListener(
        "animationend",
        function () {

            particula.remove();

        },
        {
            once: true
        }
    );

}


/* =========================================
   PARTICULAS CONTINUAS
========================================= */

function iniciarParticulas() {

    setInterval(() => {

        crearParticula();

    }, 110);

}


/* =========================================
   MOSTRAR UBICACION
========================================= */

