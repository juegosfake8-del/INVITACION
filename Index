<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ENCIENDE | Noche de Fuego</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #050303;
    color: white;
}

.pantalla {
    width: 100%;
    max-width: 430px;
    height: 100vh;
    margin: auto;
    position: relative;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 50% 90%,
            rgba(255, 92, 0, .8),
            transparent 30%
        ),
        linear-gradient(
            #050303,
            #180503 60%,
            #3b0c02
        );
}


/* =========================
   PANTALLA INICIAL
========================= */

.inicio {
    position: absolute;
    inset: 0;
    z-index: 20;

    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;

    text-align: center;

    padding-top: 70px;

    background:
        radial-gradient(
            circle at center,
            rgba(15, 55, 105, .22),
            rgba(5, 20, 45, .14) 38%,
            transparent 72%
        ),
        #050303;

    transition:
        opacity 1s ease,
        background 1.2s ease;

    box-shadow:
        inset 0 0 45px rgba(20, 80, 150, .55),
        inset 0 0 100px rgba(15, 65, 135, .45),
        inset 0 0 180px rgba(10, 50, 120, .35),
        inset 0 0 280px rgba(5, 35, 90, .25);
}


/* CAPA DEL CAMBIO AZUL A ROJO */

.inicio::after {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    opacity: 0;

    background:
        radial-gradient(
            circle at center,
            rgba(255, 45, 0, .28),
            rgba(180, 20, 0, .22) 40%,
            rgba(70, 5, 0, .45) 75%,
            rgba(20, 0, 0, .7)
        );

    box-shadow:
        inset 0 0 60px rgba(255, 50, 0, .75),
        inset 0 0 130px rgba(255, 35, 0, .55),
        inset 0 0 230px rgba(170, 15, 0, .45);

    transition:
        opacity 1.2s ease;

    z-index: 1;
}


/* HALO AZUL */

.inicio::before {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
        radial-gradient(
            circle at center,
            rgba(20, 75, 145, .18),
            transparent 68%
        );

    box-shadow:
        inset 0 0 35px rgba(30, 90, 160, .45),
        inset 0 0 85px rgba(15, 65, 135, .35),
        inset 0 0 160px rgba(10, 50, 120, .3),
        inset 0 0 250px rgba(5, 35, 90, .2);

    animation:
        haloPantalla 3s ease-in-out infinite alternate;

    transition:
        opacity 1.2s ease;

    z-index: 0;
}


@keyframes haloPantalla {

    from {
        opacity: .65;
    }

    to {
        opacity: 1;
    }

}


/* CAMBIO DE AZUL A ROJO */

.inicio.encendiendo::before {
    opacity: 0;
}

.inicio.encendiendo::after {
    opacity: 1;
}


/* DESAPARICIÓN FINAL */

.inicio.ocultar {
    opacity: 0;
    pointer-events: none;
}


/* =========================
   TEXTO DE PORTADA
========================= */

.tiempo {
    position: relative;
    z-index: 2;

    font-size: 25px;

    letter-spacing: 2px;

    color: #eeeeee;

    margin-bottom: 45px;

    text-shadow:
        0 0 10px rgba(120, 150, 190, .15);
}


/* =========================
   RELOJ DE PARED
========================= */

.reloj {
    position: relative;
    z-index: 2;

    width: 210px;
    height: 210px;

    border-radius: 50%;

    background: #0c0d10;

    border: 3px solid #d0d2d5;

    margin-bottom: 45px;

    box-shadow:
        0 2px 8px rgba(0,0,0,.8),
        inset 0 0 20px rgba(0,0,0,.9);
}


/* Borde interior */

.reloj::before {
    content: "";

    position: absolute;

    inset: 10px;

    border-radius: 50%;

    border: 1px solid rgba(255,255,255,.15);
}


/* Marcas sencillas */

.reloj .marca {
    position: absolute;

    width: 3px;
    height: 10px;

    background: #d7d7d7;

    left: 50%;
    top: 6px;

    transform-origin: 50% 99px;

    border-radius: 2px;
}


/* =========================
   MANECILLAS
========================= */

.manecilla-hora,
.manecilla-minuto,
.manecilla-segundo {
    position: absolute;

    left: 50%;
    bottom: 50%;

    transform-origin: bottom center;

    border-radius: 5px;

    z-index: 4;
}


/* Hora */

.manecilla-hora {
    width: 6px;
    height: 52px;

    background: #d9d9d9;

    transform:
        translateX(-50%)
        rotate(35deg);

    animation:
        moverHora 60s linear infinite;
}


/* Minuto */

.manecilla-minuto {
    width: 4px;
    height: 72px;

    background: #eeeeee;

    transform:
        translateX(-50%)
        rotate(120deg);

    animation:
        moverMinuto 30s linear infinite;
}


/* Segundero */

.manecilla-segundo {
    width: 2px;
    height: 84px;

    background: #899db5;

    transform:
        translateX(-50%)
        rotate(0deg);

    animation:
        moverSegundo 6s linear infinite;
}


/* Centro */

.reloj-centro {
    position: absolute;

    width: 10px;
    height: 10px;

    left: 50%;
    top: 50%;

    transform:
        translate(-50%, -50%);

    border-radius: 50%;

    background: #d8d8d8;

    z-index: 6;
}


/* =========================
   MOVIMIENTO CONTINUO
========================= */

@keyframes moverSegundo {

    from {
        transform:
            translateX(-50%)
            rotate(0deg);
    }

    to {
        transform:
            translateX(-50%)
            rotate(360deg);
    }

}


@keyframes moverMinuto {

    from {
        transform:
            translateX(-50%)
            rotate(120deg);
    }

    to {
        transform:
            translateX(-50%)
            rotate(480deg);
    }

}


@keyframes moverHora {

    from {
        transform:
            translateX(-50%)
            rotate(35deg);
    }

    to {
        transform:
            translateX(-50%)
            rotate(395deg);
    }

}


/* =========================
   BOTON DE PORTADA
========================= */

.boton-tiempo {
    position: relative;
    z-index: 3;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 12px;

    border: 1px solid rgba(190, 200, 215, .4);

    border-radius: 50px;

    padding: 14px 22px;

    background: rgba(10, 15, 22, .45);

    color: #eeeeee;

    font-size: 14px;
    letter-spacing: 2px;

    cursor: pointer;

    box-shadow:
        0 0 15px rgba(20, 55, 100, .15);

    transition: .3s;
}

.boton-tiempo:hover {
    background: rgba(25, 40, 60, .45);

    transform: scale(1.05);
}

.flecha-tiempo {
    font-size: 25px;

    line-height: 1;

    animation:
        moverFlecha 1.2s ease-in-out infinite;
}

@keyframes moverFlecha {

    0%, 100% {
        transform: translateX(0);
    }

    50% {
        transform: translateX(6px);
    }

}


/* =========================
   CONTENIDO
========================= */

.contenido {
    position: relative;
    z-index: 5;

    text-align: center;

    padding: 70px 25px;
}

.iglesia {
    font-size: 11px;
    letter-spacing: 4px;
    color: #ffc078;
}

.titulo {
    font-size: 54px;
    line-height: .85;

    margin: 25px 0 15px;

    font-weight: 900;
    letter-spacing: -4px;

    background:
        linear-gradient(
            #fff,
            #ffbd66,
            #ff4d00
        );

    -webkit-background-clip: text;
    color: transparent;

    text-shadow:
        0 0 25px rgba(255, 80, 0, .4);

    animation: entrada 1s ease;
}

.pentecostes {
    font-size: 20px;
    letter-spacing: 6px;

    color: white;

    animation: entrada 1.5s ease;
}

.descripcion {
    max-width: 330px;

    margin: 25px auto;

    line-height: 1.6;

    color: #f0cdb9;

    animation: entrada 2s ease;
}

.datos {
    display: flex;
    flex-wrap: wrap;

    justify-content: center;

    gap: 10px;

    margin: 25px 0;
}

.dato {
    padding: 11px 15px;

    border-radius: 50px;

    background:
        rgba(30, 5, 2, .7);

    border:
        1px solid rgba(255, 170, 90, .5);

    font-size: 13px;
}

.ubicacion {
    margin-top: 15px;

    display: none;

    color: #ffd4b0;

    animation: aparecer .7s ease;
}


/* =========================
   BOTÓN DE UBICACIÓN
========================= */

.boton {
    position: relative;
    z-index: 10;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 13px 20px;

    margin-top: 5px;

    border: 1px solid rgba(255, 170, 90, .55);

    border-radius: 50px;

    background:
        rgba(30, 5, 2, .75);

    color: #ffd4b0;

    font-size: 13px;
    letter-spacing: 1px;

    cursor: pointer;

    box-shadow:
        0 0 12px rgba(255, 80, 0, .15);

    transition: .3s;
}

.boton:hover {
    background:
        rgba(70, 12, 2, .85);

    transform: scale(1.04);
}


/* =========================
   FUEGO SVG
========================= */

.fuego-abajo {
    position: absolute;

    bottom: -15px;
    left: 50%;

    width: 285px;
    height: 365px;

    transform: translateX(-50%);

    z-index: 2;

    pointer-events: none;

    filter:
        drop-shadow(0 0 10px rgba(255, 40, 0, 1))
        drop-shadow(0 0 25px rgba(255, 70, 0, .95))
        drop-shadow(0 0 50px rgba(255, 90, 0, .8))
        drop-shadow(0 0 90px rgba(255, 40, 0, .55))
        drop-shadow(0 0 125px rgba(255, 20, 0, .3));
}

.fuego-abajo svg {
    width: 100%;
    height: 100%;
    overflow: visible;

    filter:
        brightness(1.15)
        saturate(1.2);
}


/* LLAMA EXTERIOR */

.llama-roja {
    transform-origin: center bottom;

    animation:
        llamaGrande 2.4s ease-in-out infinite alternate;

    filter:
        drop-shadow(0 0 8px rgba(255, 45, 0, .9))
        drop-shadow(0 0 20px rgba(255, 80, 0, .7));
}


/* LLAMA NARANJA */

.llama-naranja {
    transform-origin: center bottom;

    animation:
        llamaMedia 1.7s ease-in-out infinite alternate;

    filter:
        drop-shadow(0 0 8px rgba(255, 100, 0, 1))
        drop-shadow(0 0 18px rgba(255, 150, 0, .8));
}


/* LLAMA AMARILLA */

.llama-amarilla {
    transform-origin: center bottom;

    animation:
        llamaInterior 1.2s ease-in-out infinite alternate;

    filter:
        drop-shadow(0 0 7px rgba(255, 220, 0, 1))
        drop-shadow(0 0 16px rgba(255, 180, 0, .9));
}


/* LLAMA LATERAL IZQUIERDA */

.llama-izquierda {
    transform-origin: bottom center;

    animation:
        llamaIzquierda 1.8s ease-in-out infinite alternate;

    filter:
        drop-shadow(0 0 8px rgba(255, 60, 0, .9));
}


/* LLAMA LATERAL DERECHA */

.llama-derecha {
    transform-origin: bottom center;

    animation:
        llamaDerecha 2.1s ease-in-out infinite alternate;

    filter:
        drop-shadow(0 0 8px rgba(255, 70, 0, .9));
}


/* =========================
   MOVIMIENTO DEL FUEGO
========================= */

@keyframes llamaGrande {

    0% {
        transform:
            scaleX(.96)
            scaleY(.95)
            skewX(-2deg);
    }

    50% {
        transform:
            scaleX(1.02)
            scaleY(1.05)
            skewX(2deg);
    }

    100% {
        transform:
            scaleX(.97)
            scaleY(1.10)
            skewX(-3deg);
    }

}


@keyframes llamaMedia {

    0% {
        transform:
            translateX(-3px)
            scaleY(.90)
            skewX(-4deg);
    }

    50% {
        transform:
            translateX(4px)
            scaleY(1.10)
            skewX(4deg);
    }

    100% {
        transform:
            translateX(-2px)
            scaleY(.98)
            skewX(-2deg);
    }

}


@keyframes llamaInterior {

    0% {
        transform:
            scale(.90, .85)
            translateX(-2px);
    }

    50% {
        transform:
            scale(1.04, 1.12)
            translateX(3px);
    }

    100% {
        transform:
            scale(.95, 1.02)
            translateX(-2px);
    }

}


@keyframes llamaIzquierda {

    0% {
        transform:
            rotate(-3deg)
            scaleY(.85);
    }

    100% {
        transform:
            rotate(7deg)
            scaleY(1.15);
    }

}


@keyframes llamaDerecha {

    0% {
        transform:
            rotate(4deg)
            scaleY(.90);
    }

    100% {
        transform:
            rotate(-6deg)
            scaleY(1.12);
    }

}


/* =========================
   PARTICULAS DE FUEGO
========================= */

.particula {
    position: absolute;

    bottom: 0;

    width: 4px;
    height: 4px;

    border-radius: 50%;

    background:
        #ffb000;

    box-shadow:
        0 0 5px #ffb000,
        0 0 10px #ff5500,
        0 0 18px #ff3300;

    pointer-events: none;

    z-index: 15;

    animation:
        subirParticula linear forwards;
}


@keyframes subirParticula {

    0% {
        transform:
            translate3d(0, 0, 0)
            scale(.4);

        opacity: 0;
    }

    10% {
        opacity: 1;
    }

    50% {
        opacity: .9;
    }

    100% {
        transform:
            translate3d(
                var(--movimiento),
                var(--altura),
                0
            )
            scale(.05);

        opacity: 0;
    }

}


/* =========================
   ANIMACIONES
========================= */

@keyframes entrada {

    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}


@keyframes aparecer {

    from {
        opacity: 0;
        transform: scale(.7);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

}


.footer {
    position: absolute;

    bottom: 15px;

    width: 100%;

    text-align: center;

    font-size: 11px;

    color: #d7a994;

    z-index: 10;
}

</style>
</head>


